  <script>
    /* Theme + motion mode before first paint — no flash, no-JS safe. */
    (function () {
      var d = document.documentElement;
      try {
        var t = localStorage.getItem('codezy-site-theme');
        if (t === 'light' || t === 'dark') d.dataset.theme = t;
        else if (matchMedia('(prefers-color-scheme: light)').matches) d.dataset.theme = 'light';
      } catch (e) { /* private mode — fall back to dark */ }
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('anim');
      /* Safety net: if app.js never runs, don't leave content hidden. */
      setTimeout(function () {
        if (!document.querySelector('.reveal.in')) d.classList.remove('anim');
      }, 3500);
    })();
  </script>
